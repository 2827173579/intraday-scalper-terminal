# SOXL / SOXS Intraday Scalper - environment template
# Copy to intraday_scalper/.env (gitignored) and fill in real values.
# NEVER commit the real .env.

# --- Alpaca Markets (preferred realtime data source) --------------------------
# Paper account API keys: https://app.alpaca.markets/ -> Paper -> API Keys.
# The IEX feed is real-time but single-venue (a small share of US volume);
# bars/VWAP are IEX-only, not consolidated tape. Free plan: 30 WS symbols max.
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_DATA_FEED=iex

# --- Finnhub (fallback; free tier cannot feed the intraday engine) -----------
# Free tier: /quote is last-close snapshot only; /stock/candle 403;
# US stock realtime WebSocket trades unavailable -> DATA_UNAVAILABLE.
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: override the default config file
# INTRADAY_SCALPER_CONFIG=config/default.yaml
